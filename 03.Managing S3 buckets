- new-s3bucket -bucketname bucket-1234
- get-s3bucket : lists all buckets
- get-s3bucket | get-member -type property : it lists all the properties present for queried data in this case its s3bucket
- get-s3bucket | select bucketname
- get-s3bucket | where{ $_.bucketname -eq "bucket-1234" } | select bucketname
- get-s3bucket -bucketname bucket-1234
- remove-s3bucket =bucketname bucket-1234

